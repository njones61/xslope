# macOS
.DS_Store
**/.DS_Store

# Python virtual environment
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code local settings
.claude/settings.local.json

# Excel temporary files
~$*.xlsx

# Build artifacts
dist/
build/
site/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Installer build outputs (packaging/build_app.py). The frozen app, the .dmg and
# the NSIS setup .exe are release artifacts, never committed; only the spec, the
# build script and the installer sources under packaging/ are tracked.
packaging/dist/
packaging/build/

# Optional compiled Cython fast kernel — built locally via setup_kernel.py.
# Only the .pyx source is tracked; the generated C and shared object are not.
xslope/_fem_kernel.c
xslope/_fem_kernel*.so

# Third-party reference material is not redistributed from this repo. It lives in the
# private sibling repo, ../xslope_private/ref_docs/. This guard stops a ref_docs/ tree
# from reappearing here by accident.
ref_docs/

# Design and planning notes live in the private sibling repo, ../xslope_private/plans/.
plans/
