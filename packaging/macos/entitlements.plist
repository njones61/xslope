<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened-runtime entitlements for the notarized XSLOPE Studio build.

       A frozen Python app loads code from its own bundle at run time (the PYZ
       archive and every extension module), which the hardened runtime blocks
       unless these two are granted. They are the standard PyInstaller pair. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The AI assistant talks to a model provider over HTTPS, and the updater
       fetches latest.json. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
